# ============================================
# FleetOps Environment Variables
# Copy this to .env.local and fill in values
# Add ALL of these to Vercel → Settings → Environment Variables
# ============================================

# Google Sheets - your Sheet ID from the URL
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account (from Google Cloud Console JSON key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Admin login credentials (YOU set these)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourSecurePassword123

# JWT secret - random 32+ char string
JWT_SECRET=change_this_to_a_long_random_secret_string_here
